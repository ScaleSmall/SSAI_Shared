{
  "name": "ssai-shared",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./api": {
      "types": "./src/api.d.ts",
      "default": "./src/api.js"
    },
    "./entity-api": {
      "types": "./src/entity-api.d.ts",
      "default": "./src/entity-api.js"
    },
    "./ldp-api": {
      "types": "./src/ldp-api.d.ts",
      "default": "./src/ldp-api.js"
    },
    "./src/connect.css": "./src/connect.css",
    "./connect.css": "./src/connect.css"
  },
  "scripts": {
    "check": "npm run check:production-readiness",
    "check:production-readiness": "npm run check:contracts && npm run check:secrets && npm run check:audit && npm run check:signatures && git diff --check && npm run check:hygiene",
    "check:contracts": "node scripts/verify-connect-panel-contract.mjs && node scripts/verify-shared-api-contract.mjs && node scripts/verify-workflow-contracts.mjs",
    "check:audit": "npm audit",
    "check:signatures": "node scripts/check-npm-signatures.mjs",
    "check:connect-panel": "node scripts/verify-connect-panel-contract.mjs",
    "check:api-exports": "node scripts/verify-shared-api-contract.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "check:workflows": "node scripts/verify-workflow-contracts.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
